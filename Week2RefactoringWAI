# 4 refactored code:
from typing import Union

# Calculate employee payroll
def payroll(
    hours: Union[int, float], 
    rate: Union[int, float], 
    overtime_threshold: int = 40, 
    overtime_multiplier: float = 1.5
) -> float:
    """
    Calculate the payroll for an employee.

    Parameters:
    hours (float): Total hours worked.
    rate (float): Hourly pay rate.
    overtime_threshold (int, optional): Hours after which overtime applies. Default is 40.
    overtime_multiplier (float, optional): Overtime pay multiplier. Default is 1.5.

    Returns:
    float: Total payroll.
    """
    if not isinstance(hours, (int, float)) or not isinstance(rate, (int, float)):
        raise ValueError("Both 'hours' and 'rate' must be numeric values.")
    if hours < 0 or rate < 0:
        raise ValueError("'hours' and 'rate' must be non-negative.")

    if hours <= overtime_threshold:
        return round(hours * rate, 2)
    else:
        overtime_hours = hours - overtime_threshold
        regular_pay = overtime_threshold * rate
        overtime_pay = overtime_hours * (rate * overtime_multiplier)
        return round(regular_pay + overtime_pay, 2)

# Example usage
try:
    print("Payroll:", payroll(45, 20))
except ValueError as e:
    print("Error:", e)

